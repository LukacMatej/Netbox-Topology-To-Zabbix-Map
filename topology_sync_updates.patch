+def test_fetch_topology_xml_drops_ignored_role_leaf_node(monkeypatch: pytest.MonkeyPatch) -> None:
+    # A wall-box/patch-panel with only a single uplink (degree 1) can't be
+    # spliced through like an in-line passthrough node - it should simply be
+    # dropped from the graph entirely, along with its one edge, rather than
+    # leaking through untouched.
+    xml_payload = """
+    <mxGraphModel>
+      <root>
+        <mxCell id='0'/>
+        <mxCell id='1'/>
+        <mxCell id='node_1' vertex='1' value='Switch 1'/>
+        <mxCell id='node_2' vertex='1' value='Wall Box 12'/>
+        <mxCell id='edge_1' edge='1' source='node_1' target='node_2'/>
+      </root>
+    </mxGraphModel>
+    """
+
+    def fake_get(url, params=None, timeout=30):
+        if "xml-export" in url:
+            return FakeResponse(text=xml_payload, headers={"Content-Type": "application/xml"})
+        if "api/dcim/cables/" in url:
+            return FakeResponse(json_data={"results": []}, headers={"Content-Type": "application/json"})
+        if "api/dcim/devices/" in url:
+            return FakeResponse(
+                json_data={
+                    "results": [
+                        {
+                            "id": 1,
+                            "name": "Switch 1",
+                            "tags": [{"name": "Zabbix Map", "slug": "zabbix-map"}],
+                            "role": {"name": "Switch", "slug": "switch"},
+                        },
+                        {
+                            "id": 2,
+                            "name": "Wall Box 12",
+                            "tags": [{"name": "Other", "slug": "other"}],
+                            "role": {"name": "Wall Box", "slug": "wall-box"},
+                        },
+                    ]
+                },
+                headers={"Content-Type": "application/json"},
+            )
+        return FakeResponse(json_data={}, headers={"Content-Type": "application/json"})
+
+    client = NetBoxClient(
+        base_url="http://netbox.local",
+        token="token",
+        required_tag="Zabbix Map",
+        ignored_device_roles=("patch-panel", "wall-box"),
+    )
+    monkeypatch.setattr(client.session, "get", fake_get)
+
+    graph = client.fetch_topology("/api/plugins/netbox_topology_views/xml-export", "")
+
+    assert len(graph.nodes) == 1
+    assert graph.nodes[0].label == "Switch 1"
+    assert graph.edges == []
+
+
+def test_fetch_topology_xml_drops_ignored_role_branching_node(monkeypatch: pytest.MonkeyPatch) -> None:
+    # A patch panel with 3+ connections can't be unambiguously spliced
+    # through either - it should also be dropped, along with all of its
+    # incident edges.
+    xml_payload = """
+    <mxGraphModel>
+      <root>
+        <mxCell id='0'/>
+        <mxCell id='1'/>
+        <mxCell id='node_1' vertex='1' value='Switch 1'/>
+        <mxCell id='node_2' vertex='1' value='Switch 2'/>
+        <mxCell id='node_3' vertex='1' value='Switch 3'/>
+        <mxCell id='node_4' vertex='1' value='Patch Panel A'/>
+        <mxCell id='edge_1' edge='1' source='node_1' target='node_4'/>
+        <mxCell id='edge_2' edge='1' source='node_2' target='node_4'/>
+        <mxCell id='edge_3' edge='1' source='node_3' target='node_4'/>
+      </root>
+    </mxGraphModel>
+    """
+
+    calls = {"count": 0}
+
+    def fake_get(url, params=None, timeout=30):
+        calls["count"] += 1
+        if calls["count"] == 1:
+            return FakeResponse(text=xml_payload, headers={"Content-Type": "application/xml"})
+        if calls["count"] == 2:
+            return FakeResponse(json_data={"results": []}, headers={"Content-Type": "application/json"})
+        return FakeResponse(
+            json_data={
+                "results": [
+                    {"id": 1, "name": "Switch 1", "tags": [{"name": "Zabbix Map", "slug": "zabbix-map"}]},
+                    {"id": 2, "name": "Switch 2", "tags": [{"name": "Zabbix Map", "slug": "zabbix-map"}]},
+                    {"id": 3, "name": "Switch 3", "tags": [{"name": "Zabbix Map", "slug": "zabbix-map"}]},
+                    {"id": 4, "name": "Patch Panel A", "tags": [{"name": "Other", "slug": "other"}]},
+                ]
+            },
+            headers={"Content-Type": "application/json"},
+        )
+
+    client = NetBoxClient(base_url="http://netbox.local", token="token", required_tag="Zabbix Map")
+    monkeypatch.setattr(client.session, "get", fake_get)
+
+    graph = client.fetch_topology("/api/plugins/netbox_topology_views/xml-export", "")
+
+    assert sorted(node.label for node in graph.nodes) == ["Switch 1", "Switch 2", "Switch 3"]
+    assert graph.edges == []
+
