+                seen_edges.add(edge_key)
+                a, b = edge_key
+                ax, ay = pos[a]
+                bx, by = pos[b]
+                dx, dy = ax - bx, ay - by
+                dist = math.hypot(dx, dy) or 0.01
+                force = (dist * dist) / k
+                fx, fy = (dx / dist) * force, (dy / dist) * force
+                disp[a][0] -= fx
+                disp[a][1] -= fy
+                disp[b][0] += fx
+                disp[b][1] += fy
